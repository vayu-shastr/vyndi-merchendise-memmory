{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"vyndi-terrain-merchandise",
  "main":"src/terrain-worker.mjs",
  "compatibility_date":"2026-09-29",
  "build":{"command":"npm run build:vendor"},
  "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/","/index.html","/app.js","/styles.css","/my-road-my-glory-theme.css","/vyndi-typography.css","/vyndi-icons.svg","/assets/*","/verify","/api/*","/terrain-medal*","/*-core.mjs","/vendor/*"]},
  "observability":{"enabled":true},
  "ratelimits":[
    {"name":"API_RATE_LIMITER","namespace_id":"9201","simple":{"limit":180,"period":60}},
    {"name":"AUTH_RATE_LIMITER","namespace_id":"9202","simple":{"limit":10,"period":60}}
  ]
}
